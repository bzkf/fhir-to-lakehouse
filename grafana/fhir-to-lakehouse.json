    {
      "type": "timeseries",
      "title": "Delta operation duration p95",
      "description": "95th percentile duration of the Delta operations by operation and resource type. MERGE time grows with the size of the target table unless the table is clustered by id or uses deletion vectors.",
      "id": 17,
