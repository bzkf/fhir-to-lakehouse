          "expr": "sum by (resource_type, operation) (rate(resources_processed_total{job=~\"$job\", instance=~\"$instance\", resource_type=~\"$resource_type\"}[$__rate_interval]))",
          "legendFormat": "{{resource_type}} {{operation}}",
          "refId": "A",
          "range": true
