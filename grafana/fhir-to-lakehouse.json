    {
      "type": "timeseries",
      "title": "Time spent per trigger phase",
      "description": "Duration of each phase of the latest trigger, averaged over the selected queries. addBatch is the time spent processing the batch in foreachBatch, walCommit and commitOffsets are checkpoint writes, latestOffset queries Kafka.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (phase) (spark_streaming_query_trigger_phase_duration_seconds{job=~\"$job\", instance=~\"$instance\", query_name=~\"$query_name\", phase!=\"triggerExecution\"})",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
